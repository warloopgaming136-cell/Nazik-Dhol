# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nazikdhol

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# Admin bootstrap (used by npm run seed)
ADMIN_NAME=Nazik Admin
ADMIN_EMAIL=admin@nazikdhol.com
ADMIN_PASSWORD=Admin@12345

# Email (optional - for booking confirmation notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Nazik Dhol <no-reply@nazikdhol.com>"

# WhatsApp booking number (with country code, no + or spaces)
WHATSAPP_NUMBER=919999999999

# Client URL (for CORS)
CLIENT_URL=http://localhost:5000
